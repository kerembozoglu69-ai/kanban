@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="container py-5 text-center animate-up">
    <div class="d-inline-flex p-4 bg-danger bg-opacity-10 rounded-circle mb-4">
        <i class="fas fa-lock fa-4x text-danger"></i>
    </div>
    <h1 class="display-4 fw-800 mb-3" style="color: var(--text-head);">Erişim Engellendi</h1>
    <p class="lead text-muted mb-5">Bu sayfayı görüntülemek için gerekli yetkilere sahip değilsiniz.</p>
    
    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Home" asp-action="Index" class="btn-action">Ana Sayfa</a>
        <a asp-controller="Dashboard" asp-action="Index" class="btn px-4" style="border: 1px solid var(--border); border-radius: 12px; color: var(--text-head);">Panel'e Dön</a>
    </div>
</div>
